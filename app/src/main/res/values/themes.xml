<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.KopiDanNyemil" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/espresso</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/peach</item>
        <item name="colorOnPrimaryContainer">@color/espresso</item>
        <item name="colorSecondary">@color/caramel</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/peach</item>
        <item name="colorOnSecondaryContainer">@color/espresso</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/espresso</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/peach_light</item>
        <item name="colorSurfaceContainerHighest">@color/peach_light</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>
    </style>

    <style name="Theme.KopiDanNyemil" parent="Base.Theme.KopiDanNyemil" />

    <!-- Tombol utama (cokelat espresso) -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/espresso</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Tombol garis (outlined) -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/espresso</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/espresso</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Input teks rounded -->
    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/espresso</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="hintTextColor">@color/espresso</item>
    </style>

    <!-- Teks -->
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/espresso</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textColor">@color/espresso</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.Value" parent="">
        <item name="android:textColor">@color/espresso</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BackButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:src">@drawable/ic_arrow_back</item>
        <item name="android:contentDescription">Kembali</item>
        <item name="tint">@color/espresso</item>
    </style>
</resources>
